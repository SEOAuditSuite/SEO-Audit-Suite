ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt \
    && groupadd -g 10001 seo && useradd -u 10001 -g seo -M seo
COPY safe_http.py /app/safe_http.py
COPY deployment/c3c /app/deployment/c3c
RUN mkdir -p /run/seo-broker && chown 10001:10001 /run/seo-broker && chmod -R go-w /app
ENV PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
USER 10001:10001
ENTRYPOINT ["python", "-m", "deployment.c3c.broker"]
