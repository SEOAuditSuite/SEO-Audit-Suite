# Supply a reviewed Playwright Python base pinned by digest; no implicit latest.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt \
    && groupadd -g 10001 seo && useradd -u 10001 -g seo -M seo
COPY . /app
# Container-only broker bridge. Repository C1 source remains unchanged.
RUN cp /app/safe_http.py /app/c1_transport.py \
    && cp /app/deployment/c3c/remote_transport.py /app/safe_http.py \
    && mkdir -p /run/seo-broker && chown 10001:10001 /run/seo-broker \
    && chmod -R go-w /app
ENV PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
USER 10001:10001
ENTRYPOINT ["python", "-m", "deployment.c3c.job"]
