# REVIEW TEMPLATE ONLY. Do not apply blindly. No rules were applied in development.
# Dedicated broker bridge name must be seo-brk0. Workers use --network none.
# Add ALL host public/private addresses and provider-specific virtual services to
# blocked4. IPv6 is denied entirely in this initial profile (including mapped paths).
# Replace 192.0.2.53 with the approved resolver before acceptance; this documentation
# address deliberately makes DNS fail until configured. Check Docker/backend order.
table inet seo_c3c {
  set blocked4 {
    type ipv4_addr; flags interval;
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
      169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
      192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
      224.0.0.0/4, 240.0.0.0/4 }
  }
  chain broker_forward {
    type filter hook forward priority -20; policy accept;
    iifname "seo-brk0" meta nfproto ipv6 counter drop
    iifname "seo-brk0" ip daddr @blocked4 counter drop
    iifname "seo-brk0" ip daddr 192.0.2.53 udp dport 53 counter accept
    iifname "seo-brk0" ip daddr 192.0.2.53 tcp dport 53 counter accept
    iifname "seo-brk0" tcp dport { 80,443 } counter accept
    iifname "seo-brk0" counter drop
  }
  chain broker_host {
    type filter hook input priority -20; policy accept;
    iifname "seo-brk0" counter drop
  }
}
